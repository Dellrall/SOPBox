# The app reads these from the environment (Replit Secrets in production). It does not load this file.
# For local runs: `set -a; . src/backend/.env; set +a` after copying this to .env.

# Required for editing the catalogue and for approving deliveries.
MANAGER_PIN=

# "mock" returns fixed lines. "runpod" calls the endpoint below.
EXTRACTION_MODE=mock
RUNPOD_ENDPOINT_URL=https://api.runpod.ai/v2/<endpoint-id>/runsync
RUNPOD_API_KEY=

# Optional. With no token or chat id, alerts are skipped.
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=
TELEGRAM_STAFF_CHAT_ID=

# Optional. Defaults to src/backend/receiving.db
DB_PATH=
