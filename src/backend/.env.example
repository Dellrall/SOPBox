# The app reads these from the environment (Replit Secrets in production). It loads only the AI_ lines from this file.
# For local runs: `set -a; . src/backend/.env; set +a` after copying this to .env.

# PostgreSQL. On Replit the Database tool sets this for you.
# Locally: `python -m app.devdb` starts an embedded server and prints the value to use.
DATABASE_URL=

# The session cookie is sent over HTTPS only. Set to 0 for a plain-http local run.
COOKIE_SECURE=1

# The RunPod endpoint that reads order photos. With these empty, staff enter lines by hand.
RUNPOD_ENDPOINT_ID=<endpoint-id>
RUNPOD_API_KEY=

# Optional. One bot for the app. Each workspace owner sets their own chat ids in Settings.
# Also enables "Continue with Telegram" once the bot's domain is set with @BotFather /setdomain.
TELEGRAM_BOT_TOKEN=

# Optional. Google OAuth web client; with both, "Continue with Google" appears.
# Redirect URI: https://<your domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. 32 random bytes, base64; turns on authenticator-app two-step sign-in.
# Keep a copy: losing it stops authenticator codes (backup codes still work).
MFA_ENCRYPTION_KEY=

# Optional. At least 32 characters; turns on the support ownership-transfer route.
OPS_TOKEN=

# Optional. The model that reads sales sheets, photos and PDFs (any OpenAI-compatible endpoint).
# Without a key, sales are matched by product code and by matches people saved before.
AI_API_KEY=
AI_BASE_URL=https://litellm.rapidscreen.io/v1
AI_MODEL=gpt-5.4-mini
